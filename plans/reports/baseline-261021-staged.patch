+  :is(.motion-scrub, .motion-play) .a-move { animation-name: a-move; }
+  :is(.motion-scrub, .motion-play) .a-move-fade { animation-name: a-move-fade; }
+  :is(.motion-scrub, .motion-play) .a-draw { animation-name: a-draw; }
+  :is(.motion-scrub, .motion-play) .a-pop { animation-name: a-pop; }
